{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist -e @nestjs/microservices -e '@nestjs/microservices/*' -e @nestjs/websockets -e '@nestjs/websockets/*' -e class-transformer -e class-validator",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:integration": "bun test --max-concurrency 1 --timeout 60000 test/integration",
    "test:concurrency": "bun test --max-concurrency 1 --timeout 120000 test/concurrency",
    "test:load": "docker compose --profile load run --rm k6 run /scripts/wagering.js",
    "migration:up": "bun run src/infrastructure/database/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/migrate.ts down",
    "migration:check": "bunx mikro-orm migration:check",
    "queues:init": "bun run scripts/create-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/terminus": "12.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "nestjs-pino": "4.6.0",
    "pino": "10.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
