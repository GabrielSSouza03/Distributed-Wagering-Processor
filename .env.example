PORT=3000
APP_ROLES=api,consumer,outbox,scheduler
# Application role. lock_timeout=2s makes a contended wallet fail fast (HTTP 503).
# migration:up also reads DATABASE_URL. Run it as the postgres superuser; see README.
DATABASE_URL=postgresql://wagering_app:wagering_app@localhost:5432/wagering?options=-c%20lock_timeout%3D2s
# Superuser URL used by schema tests. The migrator does not read this variable.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo
WAGER_MAX_RECEIVES=5
LOG_LEVEL=info
OTEL_SERVICE_NAME=distributed-wagering-processor
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# DB_DEBUG=true
# Test seam used by crash-before-ack. Leave unset in normal runs.
# FAIL_AFTER_COMMIT_BEFORE_ACK=false
